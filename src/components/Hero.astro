---
import business from '../data/business.json';
import { url } from '../lib/url';
---

<section class="hero">
  <div class="page">
    <h1>{business.tagline}</h1>
    <p>
      Bookkeeping, payroll and tax preparation for freelancers and small businesses.
      One flat monthly fee, no hourly billing.
    </p>
    <a class="btn" href={url('#contact')}>Schedule a free consultation</a>
  </div>
</section>

<style>
  .hero {
    padding: 5rem 0;
    border-bottom: 4px solid var(--gold);
  }
  .hero h1 {
    font-size: clamp(2rem, 5vw, 3.25rem);
    max-width: 20ch;
  }
  .hero p {
    max-width: 55ch;
    color: var(--text-muted);
  }
</style>
